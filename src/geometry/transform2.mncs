mncs 0.18;

// mncs.geometry.transform2.v1 — 2D affine transforms over f64.
//
// An `Affine2` is a 2x2 linear part plus a translation, applied as
// M * p + t to points and M * v to vectors (translation never moves
// a displacement). Inversion is validated: a zero determinant
// reports `Inv2.Singular` instead of dividing. Rotation uses the
// sin/cos intrinsics, which agree bit-exactly across backends
// through the shared host libm.

module mncs.geometry.transform2.v1;

use mncs.geometry.point2;

record Affine2 { m00: f64, m01: f64, m10: f64, m11: f64, tx: f64, ty: f64 }

enum Inv2 { Value { inv: Affine2 }, Singular }

fn identity() -> (result: Affine2) {
    return Affine2 { m00: 1.0, m01: 0.0, m10: 0.0, m11: 1.0, tx: 0.0, ty: 0.0 };
}

fn translate(v: Vec2) -> (result: Affine2) {
    return Affine2 { m00: 1.0, m01: 0.0, m10: 0.0, m11: 1.0, tx: v.x, ty: v.y };
}

fn scale(sx: f64, sy: f64) -> (result: Affine2) {
    return Affine2 { m00: sx, m01: 0.0, m10: 0.0, m11: sy, tx: 0.0, ty: 0.0 };
}

fn uniform_scale(s: f64) -> (result: Affine2) {
    return scale(s, s);
}

fn rotate(theta: f64) -> (result: Affine2) {
    let c: f64 = cos(theta);
    let s: f64 = sin(theta);
    return Affine2 { m00: c, m01: 0.0 - s, m10: s, m11: c, tx: 0.0, ty: 0.0 };
}

fn apply_point(t: Affine2, p: Point2) -> (result: Point2) {
    return Point2 {
        x: t.m00 * p.x + t.m01 * p.y + t.tx,
        y: t.m10 * p.x + t.m11 * p.y + t.ty,
    };
}

fn apply_vec(t: Affine2, v: Vec2) -> (result: Vec2) {
    return Vec2 {
        x: t.m00 * v.x + t.m01 * v.y,
        y: t.m10 * v.x + t.m11 * v.y,
    };
}

// Compose: apply b first, then a.
fn compose(a: Affine2, b: Affine2) -> (result: Affine2) {
    return Affine2 {
        m00: a.m00 * b.m00 + a.m01 * b.m10,
        m01: a.m00 * b.m01 + a.m01 * b.m11,
        m10: a.m10 * b.m00 + a.m11 * b.m10,
        m11: a.m10 * b.m01 + a.m11 * b.m11,
        tx: a.m00 * b.tx + a.m01 * b.ty + a.tx,
        ty: a.m10 * b.tx + a.m11 * b.ty + a.ty,
    };
}

fn det(t: Affine2) -> (result: f64) {
    return t.m00 * t.m11 - t.m01 * t.m10;
}

fn inverse(t: Affine2) -> (result: Inv2) {
    let d: f64 = det(t);
    if d == 0.0 {
        return Inv2.Singular;
    }
    let inv: f64 = 1.0 / d;
    let m00: f64 = t.m11 * inv;
    let m01: f64 = (0.0 - t.m01) * inv;
    let m10: f64 = (0.0 - t.m10) * inv;
    let m11: f64 = t.m00 * inv;
    return Inv2.Value {
        inv: Affine2 {
            m00: m00,
            m01: m01,
            m10: m10,
            m11: m11,
            tx: 0.0 - (m00 * t.tx + m01 * t.ty),
            ty: 0.0 - (m10 * t.tx + m11 * t.ty),
        },
    };
}
